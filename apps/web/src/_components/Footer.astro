---
---

<footer
  class="w-full border-t border-gray-200/60 dark:border-white/10 bg-[#FAF9F6] dark:bg-[#0A0A0C] py-12 mt-20 transition-colors duration-200"
>
  <div
    class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row md:items-center justify-between gap-8 text-xs text-gray-500 dark:text-gray-400 font-sans"
  >
    <!-- Left: Logo & Nav -->
    <div
      class="flex flex-col sm:flex-row items-start sm:items-center gap-6 md:gap-10"
    >
      <a class="flex items-center gap-2.5" href="/">
        <img
          alt="Nooh logo"
          class="w-6 h-6 object-contain"
          height="24"
          src="/icon.webp"
          width="24"
        >
        <span
          class="font-bold text-base text-black dark:text-white tracking-tight"
          >nooh</span
        >
      </a>

      <div
        class="flex items-center gap-5 text-gray-600 dark:text-gray-400 font-medium"
      >
        <a
          class="hover:text-black dark:hover:text-white transition-colors"
          href="/docs"
          >Docs</a
        >
        <a
          class="hover:text-black dark:hover:text-white transition-colors"
          href="https://github.com/nehu3n/nooh"
          rel="noopener noreferrer"
          target="_blank"
          >GitHub</a
        >
        <a
          class="hover:text-black dark:hover:text-white transition-colors"
          href="/changelog"
          >Changelog</a
        >
      </div>
    </div>

    <!-- Right: Tagline & Copyright -->
    <div
      class="flex flex-col sm:flex-row items-start sm:items-center gap-8 text-gray-500 dark:text-gray-400 text-xs"
    >
      <div class="border-l border-gray-200 dark:border-white/10 pl-4 py-0.5">
        <p class="leading-tight">Build better APIs.</p>
        <p class="leading-tight">Compile with Nooh.</p>
      </div>

      <div class="text-right sm:text-left">
        <p class="leading-tight">© 2026 Nooh.</p>
        <p class="leading-tight">MIT License.</p>
      </div>
    </div>
  </div>
</footer>
