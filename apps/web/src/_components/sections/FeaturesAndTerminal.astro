---
---

<section class="w-full py-16">
  <div
    class="max-w-6xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16"
  >
    <!-- Left Column: BUILT FOR DEVELOPERS -->
    <div>
      <span
        class="text-[11px] font-mono font-semibold tracking-wider text-gray-500 dark:text-gray-400 uppercase"
      >
        BUILT FOR DEVELOPERS
      </span>
      <h2
        class="text-2xl sm:text-3xl font-bold text-black dark:text-white tracking-tight mt-1"
      >
        Modern TypeScript ergonomics.<br>
        Production ready Hono output.
      </h2>
      <p
        class="text-gray-600 dark:text-gray-400 text-xs sm:text-sm leading-relaxed mt-2 mb-8 font-sans"
      >
        Nooh gives you the structure and developer experience of a modern
        framework, with the performance and simplicity of Hono — and it
        disappears after compilation.
      </p>

      <!-- 6 Features Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-6">
        <!-- Feature 1 -->
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <svg
              aria-hidden="true"
              class="w-4 h-4 text-gray-800 dark:text-gray-200 stroke-current"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
            <h3 class="font-bold text-xs text-black dark:text-white">
              Type-safe
            </h3>
          </div>
          <p
            class="text-[11px] text-gray-500 dark:text-gray-400 leading-normal pl-6"
          >
            Full TypeScript support, from routes to context and errors.
          </p>
        </div>

        <!-- Feature 2 -->
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <svg
              aria-hidden="true"
              class="w-4 h-4 text-gray-800 dark:text-gray-200 stroke-current"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path
                d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"
              ></path>
            </svg>
            <h3 class="font-bold text-xs text-black dark:text-white">
              Modular
            </h3>
          </div>
          <p
            class="text-[11px] text-gray-500 dark:text-gray-400 leading-normal pl-6"
          >
            Composed dependencies, middleware and logic.
          </p>
        </div>

        <!-- Feature 3 -->
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <svg
              aria-hidden="true"
              class="w-4 h-4 text-gray-800 dark:text-gray-200 stroke-current"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path
                d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"
              ></path>
            </svg>
            <h3 class="font-bold text-xs text-black dark:text-white">
              File-based
            </h3>
          </div>
          <p
            class="text-[11px] text-gray-500 dark:text-gray-400 leading-normal pl-6"
          >
            Your filesystem defines your API surface.
          </p>
        </div>

        <!-- Feature 4 -->
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <svg
              aria-hidden="true"
              class="w-4 h-4 text-gray-800 dark:text-gray-200 stroke-current"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <polygon
                points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"
              ></polygon>
            </svg>
            <h3 class="font-bold text-xs text-black dark:text-white">Simple</h3>
          </div>
          <p
            class="text-[11px] text-gray-500 dark:text-gray-400 leading-normal pl-6"
          >
            No complex config. No magic.
          </p>
        </div>

        <!-- Feature 5 -->
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <svg
              aria-hidden="true"
              class="w-4 h-4 text-gray-800 dark:text-gray-200 stroke-current"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
              <polyline points="2 17 12 22 22 17"></polyline>
              <polyline points="2 12 12 17 22 12"></polyline>
            </svg>
            <h3 class="font-bold text-xs text-black dark:text-white">
              Composable
            </h3>
          </div>
          <p
            class="text-[11px] text-gray-500 dark:text-gray-400 leading-normal pl-6"
          >
            Dependency injection, middleware and logic.
          </p>
        </div>

        <!-- Feature 6 -->
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <svg
              aria-hidden="true"
              class="w-4 h-4 text-gray-800 dark:text-gray-200 stroke-current"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path d="M22 12A10 10 0 1 1 12 2v10z"></path>
            </svg>
            <h3 class="font-bold text-xs text-black dark:text-white">Fast</h3>
          </div>
          <p
            class="text-[11px] text-gray-500 dark:text-gray-400 leading-normal pl-6"
          >
            Zero runtime overhead. Just Hono.
          </p>
        </div>
      </div>
    </div>

    <!-- Right Column: BUILT FOR REAL PROJECTS -->
    <div>
      <span
        class="text-[11px] font-mono font-semibold tracking-wider text-gray-500 dark:text-gray-400 uppercase"
      >
        BUILT FOR REAL PROJECTS
      </span>
      <h2
        class="text-2xl sm:text-3xl font-bold text-black dark:text-white tracking-tight mt-1"
      >
        A clean developer experience.<br>
        From idea to production.
      </h2>

      <!-- Terminal Component -->
      <div
        class="mt-6 bg-[#0e0e11] border border-transparent dark:border-white/10 rounded-lg overflow-hidden shadow-md text-white font-mono"
      >
        <div
          class="px-4 py-3 border-b border-gray-800 flex items-center justify-between"
        >
          <div class="flex items-center gap-1.5">
            <div class="w-2.5 h-2.5 rounded-full bg-gray-700"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-gray-700"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-gray-700"></div>
          </div>
          <span class="text-[11px] text-gray-500">bash</span>
        </div>
        <div class="p-5 text-xs leading-relaxed space-y-3">
          <div>
            <span class="text-gray-500"># Create a new project</span><br>
            <span class="text-gray-200">pnpm create nooh@latest my-app</span>
            <br>
            <span class="text-gray-200">cd my-app</span>
          </div>
          <div>
            <span class="text-gray-500"># Install dependencies</span><br>
            <span class="text-gray-200">pnpm install</span>
          </div>
          <div>
            <span class="text-gray-500"># Develop</span><br>
            <span class="text-gray-200">pnpm dev</span>
          </div>
        </div>
      </div>

      <!-- 3 Checkmarks Below Terminal -->
      <div class="grid grid-cols-3 gap-4 mt-6 text-xs">
        <div>
          <div
            class="flex items-center gap-1.5 font-bold text-black dark:text-white"
          >
            <span class="text-gray-500 dark:text-gray-400 font-mono text-xs"
              >✓</span
            >
            <span>Zero config</span>
          </div>
          <p class="text-[11px] text-gray-500 dark:text-gray-400 mt-0.5">
            Just start coding.
          </p>
        </div>
        <div>
          <div
            class="flex items-center gap-1.5 font-bold text-black dark:text-white"
          >
            <span class="text-gray-500 dark:text-gray-400 font-mono text-xs"
              >✓</span
            >
            <span>Tree-shakeable</span>
          </div>
          <p class="text-[11px] text-gray-500 dark:text-gray-400 mt-0.5">
            Only what you use.
          </p>
        </div>
        <div>
          <div
            class="flex items-center gap-1.5 font-bold text-black dark:text-white"
          >
            <span class="text-gray-500 dark:text-gray-400 font-mono text-xs"
              >✓</span
            >
            <span>Works anywhere</span>
          </div>
          <p class="text-[11px] text-gray-500 dark:text-gray-400 mt-0.5">
            Node.js 18+, Bun, Deno, Serverless, etc.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
