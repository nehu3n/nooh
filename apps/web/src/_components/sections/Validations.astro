---
import { highlightCode } from "blume/markdown";

const validationRouteCode = `import { post } from "@router/users";
import { z } from "zod";

const createUserSchema = z.object({
  name: z.string().min(2),
  email: z.string().email(),
});

export default post({
  validation: {
    json: createUserSchema,
  },
  handler: async ({ c }) => {
    // validated payload is automatically typed
    const data = c.req.valid("json");

    return c.json({ user: data }, 201);
  },
});`;

const customValidatorCode = `import { config } from "@nooh-ts/nooh";
import { zValidator } from '@hono/zod-validator'

export default config({
  // Optional: swap default @hono/standard-validator
  // with any custom or Hono-supported validator
  validator: {
    engine: zValidator,
  },
});`;

const validationRouteHtml = await highlightCode(validationRouteCode, "ts", {
  icons: false,
});
const customValidatorHtml = await highlightCode(customValidatorCode, "ts", {
  icons: false,
});
---

<section class="w-full py-16">
  <div class="max-w-6xl mx-auto px-6">
    <!-- Header info -->
    <div class="mb-8">
      <span
        class="text-[11px] font-mono font-semibold tracking-wider text-gray-500 dark:text-gray-400 uppercase"
      >
        INPUT VALIDATION
      </span>
      <h2
        class="text-2xl sm:text-3xl font-bold text-black dark:text-white tracking-tight mt-1"
      >
        First-class Standard Schema validation.
      </h2>
      <p
        class="text-gray-600 dark:text-gray-400 text-xs sm:text-sm leading-relaxed max-w-lg mt-2 font-sans"
      >
        Define request validation in the
        <code
          class="font-mono text-[11px] bg-gray-100 dark:bg-white/10 px-1 py-0.5 rounded text-gray-800 dark:text-gray-200"
          >validation</code
        >
        object using any Standard Schema library (Zod, Valibot, ArkType). Nooh
        compiles it with
        <code
          class="font-mono text-[11px] bg-gray-100 dark:bg-white/10 px-1 py-0.5 rounded text-gray-800 dark:text-gray-200"
          >@hono/standard-validator</code
        >
        by default, or your choice of custom validator.
      </p>
    </div>

    <!-- Side by Side Code Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      <!-- Left: ROUTE VALIDATION -->
      <div
        class="lg:col-span-7 bg-white dark:bg-[#141418] border border-gray-200/90 dark:border-white/10 rounded-lg overflow-hidden shadow-2xs"
      >
        <div
          class="bg-gray-50/80 dark:bg-white/5 px-4 py-2.5 border-b border-gray-200/80 dark:border-white/10 flex items-center justify-between font-mono text-[11px]"
        >
          <span
            class="font-semibold text-gray-700 dark:text-gray-300 uppercase tracking-wide"
          >
            SCHEMA VALIDATION
          </span>
          <span class="text-gray-400 dark:text-gray-500"
            >src/routes/users.post.ts</span
          >
        </div>
        <div
          class="p-4 font-mono text-[11px] sm:text-xs leading-relaxed overflow-x-auto [&_pre]:m-0 [&_pre]:border-0 [&_pre]:bg-transparent [&_pre]:p-0"
        >
          <Fragment set:html={validationRouteHtml} />
        </div>
      </div>

      <!-- Right: CUSTOM ENGINE -->
      <div
        class="lg:col-span-5 bg-white dark:bg-[#141418] border border-gray-200/90 dark:border-white/10 rounded-lg overflow-hidden shadow-2xs"
      >
        <div
          class="bg-gray-50/80 dark:bg-white/5 px-4 py-2.5 border-b border-gray-200/80 dark:border-white/10 flex items-center justify-between font-mono text-[11px]"
        >
          <span
            class="font-semibold text-gray-700 dark:text-gray-300 uppercase tracking-wide"
          >
            CUSTOMIZABLE ENGINE
          </span>
          <span class="text-gray-400 dark:text-gray-500">nooh.config.ts</span>
        </div>
        <div
          class="p-4 font-mono text-[11px] sm:text-xs leading-relaxed overflow-x-auto [&_pre]:m-0 [&_pre]:border-0 [&_pre]:bg-transparent [&_pre]:p-0"
        >
          <Fragment set:html={customValidatorHtml} />
        </div>
      </div>
    </div>

    <!-- Feature Highlights -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-6">
      <div
        class="bg-white dark:bg-[#141418] border border-gray-200/90 dark:border-white/10 rounded-lg p-4 shadow-2xs"
      >
        <div class="flex items-center gap-2 mb-1.5">
          <svg
            aria-hidden="true"
            class="w-4 h-4 text-gray-800 dark:text-gray-200 stroke-current"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
          <h3 class="font-bold text-xs text-black dark:text-white">
            Standard Schema Compliant
          </h3>
        </div>
        <p
          class="text-[11px] text-gray-500 dark:text-gray-400 leading-normal pl-6"
        >
          Works seamlessly with Zod, Valibot, ArkType, or any library
          implementing the Standard Schema specification.
        </p>
      </div>

      <div
        class="bg-white dark:bg-[#141418] border border-gray-200/90 dark:border-white/10 rounded-lg p-4 shadow-2xs"
      >
        <div class="flex items-center gap-2 mb-1.5">
          <svg
            aria-hidden="true"
            class="w-4 h-4 text-gray-800 dark:text-gray-200 stroke-current"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"
            ></path>
          </svg>
          <h3 class="font-bold text-xs text-black dark:text-white">
            All Hono Request Targets
          </h3>
        </div>
        <p
          class="text-[11px] text-gray-500 dark:text-gray-400 leading-normal pl-6"
        >
          Validate
          <code
            class="font-mono text-[10px] bg-gray-100 dark:bg-white/10 px-1 py-0.5 rounded text-gray-800 dark:text-gray-200"
            >json</code
          >,
          <code
            class="font-mono text-[10px] bg-gray-100 dark:bg-white/10 px-1 py-0.5 rounded text-gray-800 dark:text-gray-200"
            >query</code
          >,
          <code
            class="font-mono text-[10px] bg-gray-100 dark:bg-white/10 px-1 py-0.5 rounded text-gray-800 dark:text-gray-200"
            >param</code
          >,
          <code
            class="font-mono text-[10px] bg-gray-100 dark:bg-white/10 px-1 py-0.5 rounded text-gray-800 dark:text-gray-200"
            >header</code
          >, or
          <code
            class="font-mono text-[10px] bg-gray-100 dark:bg-white/10 px-1 py-0.5 rounded text-gray-800 dark:text-gray-200"
            >form</code
          >.
        </p>
      </div>

      <div
        class="bg-white dark:bg-[#141418] border border-gray-200/90 dark:border-white/10 rounded-lg p-4 shadow-2xs"
      >
        <div class="flex items-center gap-2 mb-1.5">
          <svg
            aria-hidden="true"
            class="w-4 h-4 text-gray-800 dark:text-gray-200 stroke-current"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <circle cx="12" cy="12" r="3"></circle>
            <path
              d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"
            ></path>
          </svg>
          <h3 class="font-bold text-xs text-black dark:text-white">
            Pluggable Engine
          </h3>
        </div>
        <p
          class="text-[11px] text-gray-500 dark:text-gray-400 leading-normal pl-6"
        >
          Easily swap the default validator engine for any other Hono validator
          or custom validation logic.
        </p>
      </div>
    </div>
  </div>
</section>
