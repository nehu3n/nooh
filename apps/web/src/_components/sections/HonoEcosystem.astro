---
---

<section class="w-full py-16">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <!-- Header info -->
    <div class="mb-10 flex flex-col items-center">
      <span
        class="text-[11px] font-mono font-semibold tracking-wider text-gray-500 dark:text-gray-400 uppercase"
      >
        100% HONO COMPATIBLE
      </span>
      <h2
        class="text-2xl sm:text-4xl font-bold text-black dark:text-white tracking-tight mt-2 max-w-2xl"
      >
        Runs anywhere Hono runs.
      </h2>
      <p
        class="text-gray-600 dark:text-gray-400 text-xs sm:text-base leading-relaxed max-w-xl mt-3 font-sans"
      >
        Nooh compiles into native Hono applications. You get 100% compatibility
        with the entire Hono ecosystem, official middleware, and any JavaScript
        runtime out of the box.
      </p>
    </div>

    <!-- Runtimes & Platforms Marquee / Grid -->
    <div
      class="flex items-center justify-center gap-3 sm:gap-4 flex-wrap mb-10"
    >
      <div
        class="px-4 py-2 bg-white dark:bg-[#141418] border border-gray-200/90 dark:border-white/10 rounded-full text-xs font-mono font-medium text-gray-800 dark:text-gray-200 shadow-2xs flex items-center gap-2"
      >
        <span class="w-2 h-2 rounded-full bg-green-500"></span>
        <span>Node.js</span>
      </div>

      <div
        class="px-4 py-2 bg-white dark:bg-[#141418] border border-gray-200/90 dark:border-white/10 rounded-full text-xs font-mono font-medium text-gray-800 dark:text-gray-200 shadow-2xs flex items-center gap-2"
      >
        <span class="w-2 h-2 rounded-full bg-amber-500"></span>
        <span>Bun</span>
      </div>

      <div
        class="px-4 py-2 bg-white dark:bg-[#141418] border border-gray-200/90 dark:border-white/10 rounded-full text-xs font-mono font-medium text-gray-800 dark:text-gray-200 shadow-2xs flex items-center gap-2"
      >
        <span class="w-2 h-2 rounded-full bg-blue-500"></span>
        <span>Deno</span>
      </div>

      <div
        class="px-4 py-2 bg-white dark:bg-[#141418] border border-gray-200/90 dark:border-white/10 rounded-full text-xs font-mono font-medium text-gray-800 dark:text-gray-200 shadow-2xs flex items-center gap-2"
      >
        <span class="w-2 h-2 rounded-full bg-orange-500"></span>
        <span>Cloudflare Workers</span>
      </div>

      <div
        class="px-4 py-2 bg-white dark:bg-[#141418] border border-gray-200/90 dark:border-white/10 rounded-full text-xs font-mono font-medium text-gray-800 dark:text-gray-200 shadow-2xs flex items-center gap-2"
      >
        <span class="w-2 h-2 rounded-full bg-purple-500"></span>
        <span>Vercel / AWS Lambda</span>
      </div>
    </div>

    <!-- Feature Highlights -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 text-left">
      <div
        class="bg-white dark:bg-[#141418] border border-gray-200/90 dark:border-white/10 rounded-lg p-5 shadow-2xs"
      >
        <div class="flex items-center gap-2.5 mb-2">
          <svg
            aria-hidden="true"
            class="w-4 h-4 text-gray-800 dark:text-gray-200 stroke-current"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" x2="22" y1="12" y2="12"></line>
            <path
              d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
            ></path>
          </svg>
          <h3 class="font-bold text-xs text-black dark:text-white">
            Universal Runtimes
          </h3>
        </div>
        <p
          class="text-[11px] text-gray-500 dark:text-gray-400 leading-relaxed pl-6"
        >
          Deploy your API on any JavaScript runtime or edge infrastructure
          without modifying a single line of application logic.
        </p>
      </div>

      <div
        class="bg-white dark:bg-[#141418] border border-gray-200/90 dark:border-white/10 rounded-lg p-5 shadow-2xs"
      >
        <div class="flex items-center gap-2.5 mb-2">
          <svg
            aria-hidden="true"
            class="w-4 h-4 text-gray-800 dark:text-gray-200 stroke-current"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
            <polyline points="2 17 12 22 22 17"></polyline>
            <polyline points="2 12 12 17 22 12"></polyline>
          </svg>
          <h3 class="font-bold text-xs text-black dark:text-white">
            Full Hono Ecosystem
          </h3>
        </div>
        <p
          class="text-[11px] text-gray-500 dark:text-gray-400 leading-relaxed pl-6"
        >
          Use any existing Hono middleware, official packages, or third-party
          community extensions seamlessly.
        </p>
      </div>

      <div
        class="bg-white dark:bg-[#141418] border border-gray-200/90 dark:border-white/10 rounded-lg p-5 shadow-2xs"
      >
        <div class="flex items-center gap-2.5 mb-2">
          <svg
            aria-hidden="true"
            class="w-4 h-4 text-gray-800 dark:text-gray-200 stroke-current"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <polyline points="16 18 22 12 16 6"></polyline>
            <polyline points="8 6 2 12 8 18"></polyline>
          </svg>
          <h3 class="font-bold text-xs text-black dark:text-white">
            Zero Lock-in
          </h3>
        </div>
        <p
          class="text-[11px] text-gray-500 dark:text-gray-400 leading-relaxed pl-6"
        >
          Hono is the entrypoint. Your project compiles to readable standard
          TypeScript that you own completely.
        </p>
      </div>
    </div>
  </div>
</section>
