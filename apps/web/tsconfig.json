{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "isolatedDeclarations": false,
    "allowJs": true,
    "checkJs": true,
    "paths": {
      "@components/*": ["./src/_components/*"],
      "@sections/*": ["./src/_components/sections/*"],
      "@layouts/*": ["./src/_layouts/*"],
      "@styles/*": ["./styles/*"],
      "@data/*": ["./src/data/*"]
    }
  },
  "include": ["blume.config.ts", "docs/**/*.ts", "docs/**/*.tsx", "src/**/*"]
}
