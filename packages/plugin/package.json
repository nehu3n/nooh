{
  "name": "@nooh-ts/plugin",
  "version": "0.1.0",
  "description": "Bundler integrations for Nooh.",
  "keywords": [
    "nooh",
    "hono",
    "unplugin",
    "vite",
    "rollup",
    "rolldown",
    "webpack",
    "rspack",
    "esbuild"
  ],
  "homepage": "https://nooh-ts.pages.dev",
  "bugs": {
    "url": "https://github.com/nehu3n/nooh/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nehu3n/nooh.git",
    "directory": "packages/plugin"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs"
    },
    "./rollup": {
      "types": "./dist/rollup.d.mts",
      "import": "./dist/rollup.mjs"
    },
    "./rolldown": {
      "types": "./dist/rolldown.d.mts",
      "import": "./dist/rolldown.mjs"
    },
    "./webpack": {
      "types": "./dist/webpack.d.mts",
      "import": "./dist/webpack.mjs"
    },
    "./rspack": {
      "types": "./dist/rspack.d.mts",
      "import": "./dist/rspack.mjs"
    },
    "./rsbuild": {
      "types": "./dist/rsbuild.d.mts",
      "import": "./dist/rsbuild.mjs"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.mts",
      "import": "./dist/esbuild.mjs"
    },
    "./farm": {
      "types": "./dist/farm.d.mts",
      "import": "./dist/farm.mjs"
    },
    "./bun": {
      "types": "./dist/bun.d.mts",
      "import": "./dist/bun.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "readme.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nooh-ts/compiler": "workspace:*",
    "jiti": "^2.7.0",
    "unplugin": "^3.3.0"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
