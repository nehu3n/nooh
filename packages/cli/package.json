{
  "name": "@nooh-ts/cli",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "bin": {
    "nooh": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
