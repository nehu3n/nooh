{
  "name": "@nooh-ts/cli",
  "version": "0.1.0",
  "description": "The command-line interface for Nooh.",
  "keywords": [
    "nooh",
    "hono",
    "cli",
    "typescript",
    "framework"
  ],
  "homepage": "https://nooh-ts.pages.dev",
  "bugs": {
    "url": "https://github.com/nehu3n/nooh/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nehu3n/nooh.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "bin": {
    "nooh": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "readme.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nooh-ts/compiler": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
